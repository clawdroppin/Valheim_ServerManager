{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valheim Server Manager",
  "version": "1.0.0",
  "identifier": "com.valheimservermanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1470",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Valheim Server Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#0a0e12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Valheim dedicated server manager",
    "longDescription": "Install, configure, monitor, back up and automate Valheim dedicated servers.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "clawdroppin",
    "copyright": "Copyright (c) 2026 clawdroppin - MIT License",
    "homepage": "https://github.com/clawdroppin/Valheim_ServerManager"
  }
}
