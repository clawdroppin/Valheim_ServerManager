{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 1470
    },
    {
      "name": "ui-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "1480"
      ],
      "port": 1480
    },
    {
      "name": "site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "dist-site",
        "--port",
        "1490",
        "--strictPort"
      ],
      "port": 1490
    }
  ]
}